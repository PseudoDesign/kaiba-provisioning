{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-stable-verifier-candidate-v1alpha1.schema.json",
  "title": "Public native Pi 5 stable-verifier candidate configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-stable-verifier-candidate/v1alpha1"
    },
    "verifier_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "minimum_security_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "authority_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "cohort_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "authority_key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "logical_identity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    }
  },
  "required": [
    "audience",
    "authority_key_id",
    "authority_url",
    "cohort_id",
    "logical_identity",
    "minimum_security_epoch",
    "schema_version",
    "slot_id",
    "verifier_version"
  ]
}
