{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaiba:contracts:0.1.0-draft.1:common",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?Z$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "recordRef": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "record_id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "uri",
        "digest"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "logical_device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
        },
        "storage_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_desired_state_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "logical_device_id",
        "instance_id",
        "storage_generation",
        "expected_desired_state_revision"
      ],
      "additionalProperties": false
    }
  }
}
