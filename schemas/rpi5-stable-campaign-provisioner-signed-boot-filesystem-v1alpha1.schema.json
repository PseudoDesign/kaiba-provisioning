{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-stable-campaign-provisioner-signed-boot-filesystem-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 stable-campaign provisioner signed boot filesystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_revision",
    "unsigned_artifact_set",
    "expected_customer_key_hash",
    "public_key",
    "root_target_policy",
    "signature_verification",
    "device_binding",
    "artifacts",
    "fat",
    "bundle_digest",
    "signing_status",
    "hardware_observed",
    "physical_staging_ready",
    "production_ready"
  ],
  "properties": {
    "schema": {
      "const": "provisioning.kaiba.network/rpi5-stable-campaign-provisioner-signed-boot-filesystem/v1alpha1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "unsigned_artifact_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "bundle_digest"],
      "properties": {
        "schema": {
          "const": "provisioning.kaiba.network/rpi5-stable-campaign-provisioner-artifact-set/v1alpha1"
        },
        "bundle_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "expected_customer_key_hash": {
      "const": "sha256:b8818acea4e71173903ee003e33ed37e969def7d2ea67bec15c0b73cb36c3895"
    },
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_digest", "fingerprint", "customer_key_hash"],
      "properties": {
        "file_digest": {
          "const": "sha256:93923fb1b289c39e8b336b90defb881f5d15ce3832c74655b295e1a35bfdab80"
        },
        "fingerprint": {
          "const": "sha256:0e68e7196fedc382ca435b995598e92d0fe36e4b1a1f949f85f5f2e6e2920fb9"
        },
        "customer_key_hash": {
          "const": "sha256:b8818acea4e71173903ee003e33ed37e969def7d2ea67bec15c0b73cb36c3895"
        }
      }
    },
    "root_target_policy": { "$ref": "#/$defs/root_target_policy" },
    "signature_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "status"],
      "properties": {
        "algorithm": { "const": "rsa2048-sha256" },
        "status": { "const": "verified" }
      }
    },
    "device_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "boot_media",
        "disk_guid",
        "boot_partition",
        "boot_partition_guid",
        "boot_partition_size_bytes"
      ],
      "properties": {
        "profile": { "const": "rpi5-sd-mmcblk0-fixed-partitions" },
        "boot_media": { "const": "/dev/mmcblk0" },
        "disk_guid": { "const": "5625eee2-0c8a-402f-8c2f-5a1347652bb2" },
        "boot_partition": { "const": 1 },
        "boot_partition_guid": { "const": "59d06b61-bf85-4d77-89c3-9e5395934ff8" },
        "boot_partition_size_bytes": { "const": 134217728 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot_image_signing_input", "boot_signature", "boot_filesystem"],
      "properties": {
        "boot_image_signing_input": { "$ref": "#/$defs/boot_image_input" },
        "boot_signature": { "$ref": "#/$defs/boot_signature" },
        "boot_filesystem": { "$ref": "#/$defs/boot_filesystem" }
      }
    },
    "fat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_label", "volume_id", "files", "config_content"],
      "properties": {
        "volume_label": { "const": "KAIBA_BOOT" },
        "volume_id": { "const": "4b414942" },
        "files": { "const": ["boot.img", "boot.sig", "config.txt"] },
        "config_content": { "const": "boot_ramdisk=1\n" }
      }
    },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "signing_status": { "const": "signed-and-verified" },
    "hardware_observed": { "const": false },
    "physical_staging_ready": { "const": false },
    "production_ready": { "const": false }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "root_target_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "development_posture_id",
        "source_revision",
        "expected_customer_key_hash",
        "persistent_root",
        "mutable_state",
        "rollback_gate",
        "enrollment_ready",
        "videocore_jtag",
        "eeprom_write_protection",
        "development_access",
        "digest"
      ],
      "properties": {
        "schema": { "const": "provisioning.kaiba.network/target-policy/v1alpha1" },
        "development_posture_id": {
          "const": "raspberry-pi-5-sacrificial-development-v1alpha1"
        },
        "source_revision": { "$ref": "#/properties/source_revision" },
        "expected_customer_key_hash": {
          "const": "sha256:b8818acea4e71173903ee003e33ed37e969def7d2ea67bec15c0b73cb36c3895"
        },
        "persistent_root": { "const": "dm-verity" },
        "mutable_state": { "const": "tmpfs-only" },
        "rollback_gate": { "const": "unimplemented" },
        "enrollment_ready": { "const": false },
        "videocore_jtag": { "const": "unlocked-development" },
        "eeprom_write_protection": { "const": "unlocked-development" },
        "development_access": {
          "const": {
            "enabled": true,
            "transport": "usb-gadget-ethernet",
            "address": "10.0.0.2",
            "user": "codex",
            "root_via_passwordless_sudo": true,
            "ephemeral_host_key": true
          }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "boot_image_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "storage_format", "digest", "size_bytes"],
      "properties": {
        "artifact_role": { "const": "signing-input" },
        "storage_format": { "const": "fat-boot-ramdisk-not-partition" },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "const": 100663296 }
      }
    },
    "boot_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "format", "digest", "size_bytes", "timestamp"],
      "properties": {
        "artifact_role": { "const": "signature" },
        "format": { "const": "raspberry-pi-three-line-rsa2048" },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": {
          "type": "integer",
          "minimum": 590,
          "maximum": 640
        },
        "timestamp": {
          "type": "string",
          "pattern": "^ts: (0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
        }
      }
    },
    "boot_filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "storage_format", "path", "digest", "size_bytes"],
      "properties": {
        "artifact_role": { "const": "boot-filesystem-partition-image" },
        "storage_format": { "const": "fat32-filesystem-partition-image" },
        "path": { "const": "sd/boot-filesystem.img" },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "const": 134217728 }
      }
    }
  }
}
